<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="CiteVC" customModule="PlatePulse" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="ov"/>
                <outlet property="titleLbl" destination="tt" id="o0"/>
                <outlet property="bodyLbl" destination="bd" id="o1"/>
                <outlet property="closeBtn" destination="cl" id="o2"/>
                <outlet property="table" destination="tb" id="o3"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" text="Sources" translatesAutoresizingMaskIntoConstraints="NO" id="tt"/>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="close" translatesAutoresizingMaskIntoConstraints="NO" id="cl">
                    <constraints>
                        <constraint firstAttribute="width" constant="44" id="clw"/>
                        <constraint firstAttribute="height" constant="44" id="clh"/>
                    </constraints>
                </button>
                <label opaque="NO" text="Body" translatesAutoresizingMaskIntoConstraints="NO" id="bd"/>
                <tableView clipsSubviews="YES" contentMode="scaleToFill" style="plain" separatorStyle="default" rowHeight="-1" estimatedRowHeight="-1" translatesAutoresizingMaskIntoConstraints="NO" id="tb">
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                </tableView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe"/>
            <color key="backgroundColor" name="plp_background"/>
            <constraints>
                <constraint firstItem="tt" firstAttribute="top" secondItem="safe" secondAttribute="top" constant="8" id="c1"/>
                <constraint firstItem="tt" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="c2"/>
                <constraint firstItem="cl" firstAttribute="centerY" secondItem="tt" secondAttribute="centerY" id="c3"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="cl" secondAttribute="trailing" constant="16" id="c4"/>
                <constraint firstItem="cl" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="tt" secondAttribute="trailing" constant="8" id="c5"/>
                <constraint firstItem="bd" firstAttribute="top" secondItem="tt" secondAttribute="bottom" constant="8" id="c6"/>
                <constraint firstItem="bd" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="16" id="c7"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="bd" secondAttribute="trailing" constant="16" id="c8"/>
                <constraint firstItem="tb" firstAttribute="top" secondItem="bd" secondAttribute="bottom" constant="16" id="c9"/>
                <constraint firstItem="tb" firstAttribute="leading" secondItem="safe" secondAttribute="leading" id="c10"/>
                <constraint firstItem="tb" firstAttribute="trailing" secondItem="safe" secondAttribute="trailing" id="c11"/>
                <constraint firstItem="tb" firstAttribute="bottom" secondItem="safe" secondAttribute="bottom" id="c12"/>
            </constraints>
        </view>
    </objects>
    <resources>
        <namedColor name="plp_background">
            <color red="0.0" green="0.212" blue="0.227" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
