<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
        <capability name="Stack View standard spacing" minToolsVersion="9.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="OnbVC" customModule="PlatePulse" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="ov"/>
                <outlet property="scroll" destination="sc" id="o0"/>
                <outlet property="artImg" destination="ai" id="o1"/>
                <outlet property="titleLbl" destination="tt" id="o2"/>
                <outlet property="bodyLbl" destination="bd" id="o3"/>
                <outlet property="pageCtrl" destination="pc" id="o4"/>
                <outlet property="nextBtn" destination="nx" id="o5"/>
                <outlet property="skipBtn" destination="sk" id="o6"/>
                <outlet property="tgtBox" destination="tb" id="o7"/>
                <outlet property="kcalField" destination="kf" id="o8"/>
                <outlet property="protField" destination="pf" id="o9"/>
                <outlet property="carbField" destination="cf" id="o10"/>
                <outlet property="fatField" destination="ff" id="o11"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="sc">
                    <subviews>
                        <stackView axis="vertical" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="st">
                            <subviews>
                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="ai">
                                    <constraints>
                                        <constraint firstAttribute="height" constant="240" id="aih"/>
                                    </constraints>
                                </imageView>
                                <label opaque="NO" text="Title" translatesAutoresizingMaskIntoConstraints="NO" id="tt"/>
                                <label opaque="NO" text="Body" translatesAutoresizingMaskIntoConstraints="NO" id="bd"/>
                                <pageControl contentMode="scaleToFill" numberOfPages="4" translatesAutoresizingMaskIntoConstraints="NO" id="pc">
                                    <constraints>
                                        <constraint firstAttribute="height" constant="44" id="pch"/>
                                    </constraints>
                                </pageControl>
                                <stackView hidden="YES" axis="vertical" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="tb">
                                    <subviews>
                                        <textField opaque="NO" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="kcal" translatesAutoresizingMaskIntoConstraints="NO" id="kf">
                                            <constraints>
                                                <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="kfh"/>
                                            </constraints>
                                        </textField>
                                        <textField opaque="NO" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="protein" translatesAutoresizingMaskIntoConstraints="NO" id="pf">
                                            <constraints>
                                                <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="pfh"/>
                                            </constraints>
                                        </textField>
                                        <textField opaque="NO" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="carbs" translatesAutoresizingMaskIntoConstraints="NO" id="cf">
                                            <constraints>
                                                <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="cfh"/>
                                            </constraints>
                                        </textField>
                                        <textField opaque="NO" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="fat" translatesAutoresizingMaskIntoConstraints="NO" id="ff">
                                            <constraints>
                                                <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="ffh"/>
                                            </constraints>
                                        </textField>
                                    </subviews>
                                </stackView>
                                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="nx">
                                    <constraints>
                                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="nxh"/>
                                    </constraints>
                                    <state key="normal" title="Next"/>
                                </button>
                                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="sk">
                                    <constraints>
                                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="44" id="skh"/>
                                    </constraints>
                                    <state key="normal" title="Skip"/>
                                </button>
                            </subviews>
                        </stackView>
                    </subviews>
                    <constraints>
                        <constraint firstItem="st" firstAttribute="top" secondItem="sc" secondAttribute="top" constant="16" id="y1"/>
                        <constraint firstItem="st" firstAttribute="leading" secondItem="sc" secondAttribute="leading" constant="16" id="y2"/>
                        <constraint firstItem="sc" firstAttribute="trailing" secondItem="st" secondAttribute="trailing" constant="16" id="y3"/>
                        <constraint firstItem="sc" firstAttribute="bottom" secondItem="st" secondAttribute="bottom" constant="16" id="y4"/>
                        <constraint firstItem="st" firstAttribute="width" secondItem="sc" secondAttribute="width" constant="-32" id="y5"/>
                    </constraints>
                </scrollView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe"/>
            <color key="backgroundColor" name="plp_background"/>
            <constraints>
                <constraint firstItem="sc" firstAttribute="top" secondItem="safe" secondAttribute="top" id="ox1"/>
                <constraint firstItem="sc" firstAttribute="leading" secondItem="safe" secondAttribute="leading" id="ox2"/>
                <constraint firstItem="sc" firstAttribute="trailing" secondItem="safe" secondAttribute="trailing" id="ox3"/>
                <constraint firstItem="sc" firstAttribute="bottom" secondItem="safe" secondAttribute="bottom" id="ox4"/>
            </constraints>
        </view>
    </objects>
    <resources>
        <namedColor name="plp_background">
            <color red="0.0" green="0.212" blue="0.227" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
